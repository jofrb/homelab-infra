# Traefik static config. Routes live in /etc/traefik/dynamic (file provider).
# Ansible owns this file; the dashboard and API stay off.

api:
  dashboard: false

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"

providers:
  file:
    directory: /etc/traefik/dynamic
    watch: true

certificatesResolvers:
  letsencrypt:
    acme:
      email: {{ traefik_acme_email }}
      storage: /etc/traefik/acme/acme.json
      dnsChallenge:
        provider: cloudflare
        # Public resolvers for the propagation check. The host's own resolver
        # is AdGuard, which doesn't need to see these queries.
        resolvers:
          - "1.1.1.1:53"
          - "1.0.0.1:53"

log:
  level: INFO
