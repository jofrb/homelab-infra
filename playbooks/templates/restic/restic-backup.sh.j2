#!/usr/bin/env bash
set -euo pipefail

ENV_FILE=/etc/restic/b2.env
# shellcheck source=/dev/null
source "$ENV_FILE"

export B2_ACCOUNT_ID B2_ACCOUNT_KEY RESTIC_REPOSITORY RESTIC_PASSWORD

# Report start and exit code to healthchecks.io; it alerts on non-zero exit,
# on a run that never finishes, and on a run that never starts. Ping failures
# must not fail the backup itself.
HC_URL="https://hc-ping.com/{{ healthchecks_ping_key }}/restic-backup"
curl -fsS -m 10 --retry 3 -o /dev/null "$HC_URL/start" || true
trap 'curl -fsS -m 10 --retry 3 -o /dev/null "$HC_URL/$?" || true' EXIT

# Initialise the repository if it doesn't exist yet.
if ! restic snapshots --no-lock &>/dev/null; then
  echo "Initialising restic repository..."
  restic init
fi

restic backup \
  --verbose \
  --tag photos \
  {{ restic_backup_paths | join(' \\\n  ') }}

# Keep 7 daily, 4 weekly, 12 monthly snapshots; remove the rest.
restic forget \
  --prune \
  --keep-daily   7 \
  --keep-weekly  4 \
  --keep-monthly 12 \
  --tag photos
