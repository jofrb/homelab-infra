[Unit]
Description=Restic repository integrity check (1/6 of B2 data)
After=network-online.target
Wants=network-online.target
# If the backup is still running when the check is triggered, queue behind it.
After=restic-backup.service

[Service]
Type=oneshot
Environment=RESTIC_CACHE_DIR=/var/cache/restic
ExecStart=/usr/local/bin/restic-check
IOSchedulingClass=idle
CPUSchedulingPolicy=idle
Nice=19
StandardOutput=journal
StandardError=journal
SyslogIdentifier=restic-check
