# Ansible retry files
*.retry

# Ansible vault password files
.vault_pass
.vault_password
vault_password_file

# Sensitive variable overrides (use vault for secrets instead)
**/vault.yml
**/*_vault.yml
**/secrets.yml
# Encrypted vault files are safe to commit
!group_vars/*_vault.yml
!group_vars/*/vault.yml

# Installed collections and roles
collections/
roles/galaxy/

# Python
__pycache__/
*.pyc
.venv/
venv/

# macOS
.DS_Store

# Editor
.idea/
.vscode/
*.swp
*.swo

# AI
.claude/
.cursor/
.copilot/
.aider*
.continue/
